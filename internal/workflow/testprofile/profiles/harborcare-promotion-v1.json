{
  "format": "hcmnext.workflow.test-profile/v1",
  "ref": { "id": "harborcare-promotion", "version": 1 },
  "name": "HarborCare promotion",
  "tenant": "harborcare-demo",
  "datasets": [
    {
      "id": "harborcare-workers",
      "version": "2026.1",
      "source": "internal/domains/fixtures/testdata/workers.json"
    },
    {
      "id": "harborcare-pay-bands",
      "version": "2026.1",
      "source": "internal/domains/fixtures/testdata/demo-bands.json"
    },
    {
      "id": "workflow-conformance",
      "version": "2026.1",
      "source": "internal/workflow/conformance/managerchange/environment.go"
    }
  ],
  "responses": [
    {
      "node_id": "snapshot_worker",
      "capability_id": "hcmnext.people.explain_worker_state",
      "capability_version": 1,
      "outcome": "SUCCEEDED",
      "fields": [
        {
          "path": "worker_id",
          "type": { "kind": "STRING", "brand": "WorkerID" },
          "value": "11111111-1111-4111-8111-111111111111"
        },
        {
          "path": "current_job_id",
          "type": { "kind": "STRING", "brand": "JobID" },
          "value": "ENG-SWE3"
        },
        { "path": "current_level", "type": { "kind": "STRING" }, "value": "P3" },
        {
          "path": "manager_id",
          "type": { "kind": "STRING", "brand": "WorkerID" },
          "value": "rel_mgr_1001"
        },
        { "path": "employment_active", "type": { "kind": "BOOL" }, "value": "true" }
      ],
      "detail": "HarborCare seed worker jane-doe, observed from the checked-in people corpus."
    },
    {
      "node_id": "snapshot_worker",
      "capability_id": "hcmnext.people.explain_worker_state",
      "capability_version": 1,
      "outcome": "REJECTED",
      "detail": "The governed worker read withheld or could not confirm the subject."
    },
    {
      "node_id": "simulate_compensation",
      "capability_id": "hcmnext.rewards.simulate_compensation",
      "capability_version": 1,
      "outcome": "SUCCEEDED",
      "fields": [
        {
          "path": "annualized_delta",
          "type": { "kind": "MONEY" },
          "value": "15000.00 USD"
        },
        { "path": "raise_ratio", "type": { "kind": "DECIMAL" }, "value": "9.0909" },
        {
          "path": "cost_center",
          "type": { "kind": "STRING" },
          "value": "cost-center:eng-platform"
        }
      ],
      "detail": "Jane Doe's seed base pay of USD 165000.00 moves to USD 180000.00."
    },
    {
      "node_id": "evaluate_band",
      "capability_id": "hcmnext.rewards.evaluate_pay_band_position",
      "capability_version": 1,
      "outcome": "SUCCEEDED",
      "fields": [
        { "path": "band_position", "type": { "kind": "STRING" }, "value": "WITHIN" },
        { "path": "within_band", "type": { "kind": "BOOL" }, "value": "true" }
      ],
      "detail": "USD 180000.00 is within HarborCare's ENG-MGR1/M1 US-WEST band (USD 166000.00–245000.00)."
    },
    {
      "node_id": "evaluate_band",
      "capability_id": "hcmnext.rewards.evaluate_pay_band_position",
      "capability_version": 1,
      "outcome": "AMBIGUOUS",
      "detail": "The requested band record could not be resolved."
    },
    {
      "node_id": "observe_projection",
      "capability_id": "hcmnext.operations.detect_drift",
      "capability_version": 1,
      "outcome": "PASS",
      "detail": "The seeded projection matches the expected workflow state."
    },
    {
      "node_id": "observe_projection",
      "capability_id": "hcmnext.operations.detect_drift",
      "capability_version": 1,
      "outcome": "FAIL",
      "detail": "The seeded projection differs from the expected workflow state."
    },
    {
      "node_id": "observe_projection",
      "capability_id": "hcmnext.operations.detect_drift",
      "capability_version": 1,
      "outcome": "UNKNOWN",
      "detail": "No authoritative projection sample is available."
    }
  ]
}
