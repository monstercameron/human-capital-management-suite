# Dependencies
node_modules/
**/node_modules/

# TypeScript / JavaScript build artifacts
dist/
**/dist/
build/
**/build/
out/
**/out/
.next/
**/.next/
.turbo/
**/.turbo/
coverage/
**/coverage/
*.tsbuildinfo

# Go build and test artifacts
bin/
**/bin/
*.exe
*.test
*.out
coverage.out

# Logs
logs/
**/logs/
*.log

# Local environment and secret material
.env
.env.*
!.env.example
.envrc
.env.local
.env.*.local
secrets/
.secrets/
**/secrets/
*.pem
*.key
*.p12
*.pfx
*.crt
*.csr
*.jks
*.keystore
id_rsa*
id_ed25519*
*.kubeconfig
service-account*.json
*-service-account.json
google-credentials*.json
firebase-adminsdk*.json

# Local database/runtime scratch
*.sqlite
*.sqlite3
*.db
*.db-journal
tmp/
temp/
**/tmp/
**/temp/

# Local editor/OS state
.DS_Store
Thumbs.db
.vscode/
.idea/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Playwright test artifacts
test-results/
playwright-report/
blob-report/
*.png
*.jpg
*.jpeg
*.webp
!internal/humanwork/workspace/assets/person-*.png
!internal/humanwork/workspace/assets/person-*-small.jpg

.husky/_/

# Built GoWebComponents/WASM bundles are embedded at build time, never committed
internal/humanwork/workspace/assets/*.wasm
internal/humanwork/workspace/assets/wasm_exec.js

# Build and test artifacts that lanes, go test and local tooling leave inside the checkout.
# Go build and module caches redirected into the repository
.go-build-*
.gocache*
.gomodcache*
*gocache*
# go test / lane scratch directories
.gotmp-*
.lane-go-*
.tmp-go-*
.tmp-*
/tmp/
# embedded PostgreSQL runtime and archive caches
.pg-cache-*
.pgcache-*
.codex-*/
.codex-*
.gotmp/
.lane-gotmp-*
.artifacts/
# go test build trees left in package directories when GOTMPDIR is unset
go-build[0-9]*/
.pgcache/
.lane-*

# internal/trust/secrets is source (the custody-port resolver), not secret material;
# the **/secrets/ rule above must not hide it.
!internal/trust/secrets/

# Stray wasm build output if journeywasm is run without -out
/journeywasm
